<!DOCTYPE html>
<html lang="en">
<head>
{% include "head.njk" %}
{% if extraStyles %}{{ extraStyles | safe }}{% endif %}
</head>
<body class="slide-page">
<main class="slide{% if slideClass %} {{ slideClass }}{% endif %}">
  <div class="slide__body">
    {{ content | safe }}
  </div>
  {% include "chrome.njk" %}
</main>
{% if hint %}<div class="hint">{{ hint | safe }}</div>{% endif %}
<script src="assets/js/report.js"></script>
</body>
</html>
