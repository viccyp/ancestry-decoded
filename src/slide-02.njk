permalink: slide-02.html
pageTitle: Analysis Results
slideNum: 2
chromeLabel: Analysis Results
chromeTheme: light
prevHref: slide-01.html
nextHref: slide-03.html
---
<!DOCTYPE html>
<html lang="en">
<head>
{% include "head.njk" %}
<style>
  .results {
    flex: 1;
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding: calc(var(--margin) + 0.5rem) var(--margin) var(--margin);
    align-items: start;
  }
  .results__head h2 { margin: 0.6rem 0 1rem; max-width: 16ch; }
  .results__match {
    display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap;
    margin-bottom: 1.2rem;
  }
  .results__region {
    font-family: var(--serif);
    font-size: clamp(1.8rem, 2.8vw, 2.6rem);
    color: var(--forest);
    line-height: 1.05;
  }
  .results__score {
    font-family: var(--serif);
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    color: var(--gold);
    line-height: 1;
  }
  .results__score-l {
    font-size: 0.62rem; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--ink-60);
  }
  .results__overview { font-size: 0.86rem; line-height: 1.75; max-width: 44ch; margin: 0 0 1.6rem; }
  .term-list { border-top: 1px solid var(--line); }
  .term-item { padding: 0.85rem 0; border-bottom: 1px solid var(--line); }
  .term-item dt {
    font-family: var(--serif); font-weight: 600; font-size: 1rem;
    color: var(--forest); margin: 0 0 0.3rem;
  }
  .term-item dd { margin: 0; font-size: 0.78rem; line-height: 1.65; color: var(--ink-60); }

  .map-panel {
    border: 1px solid var(--line-gold);
    background: var(--cream-2);
    padding: 1.2rem;
  }
  .map-panel h3 {
    font-size: 0.62rem; font-weight: 700; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--bronze); margin: 0 0 1rem;
  }
  .map-wrap { position: relative; aspect-ratio: 2 / 1; overflow: hidden; background: #d8e4ec; }
  .map-wrap img { width: 100%; height: 100%; object-fit: cover; opacity: 0.9; }
  .map-highlight {
    position: absolute;
    border-radius: 50%;
    border: 2px solid var(--orange);
    background: rgba(200, 90, 23, 0.25);
    box-shadow: 0 0 0 6px rgba(200, 90, 23, 0.12);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .map-label {
    position: absolute; z-index: 3;
    font-size: 0.58rem; font-weight: 700; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--cream);
    background: var(--orange); padding: 0.35rem 0.65rem;
    transform: translate(-50%, -140%);
    white-space: nowrap;
  }
</style>
</head>
<body class="slide-page">
<main class="slide">
  <div class="slide__body">
    <section class="results">
      <div class="results__left">
        <span class="kicker">{{ report.analysisResults.kicker }}</span>
        <div class="results__head">
          <h2 class="display">{{ report.analysisResults.headline | safe }}</h2>
        </div>
        <div class="results__match">
          <div>
            <div class="results__region">{{ report.analysisResults.topRegion }}</div>
            <div class="results__score-l">{{ report.analysisResults.matchLabel }}</div>
          </div>
          <div class="results__score">{{ report.analysisResults.matchScore }}</div>
        </div>
        <p class="results__overview">{{ report.analysisResults.overview }}</p>
        <dl class="term-list">
          {% for item in report.analysisResults.featureOverview %}
          <div class="term-item">
            <dt>{{ item.term }}</dt>
            <dd>{{ item.plain }}</dd>
          </div>
          {% endfor %}
        </dl>
      </div>

      <div class="map-panel">
        <h3>Regional correspondence map</h3>
        <div class="map-wrap">
          <img src="{{ report.images.mapBase }}" alt="World map" />
          <div class="map-highlight" style="left:{{ report.analysisResults.mapHighlight.x }}%;top:{{ report.analysisResults.mapHighlight.y }}%;width:{{ report.analysisResults.mapHighlight.radius * 2 }}%;aspect-ratio:1;"></div>
          <span class="map-label" style="left:{{ report.analysisResults.mapHighlight.x }}%;top:{{ report.analysisResults.mapHighlight.y }}%;">{{ report.analysisResults.topRegion }}</span>
        </div>
      </div>
    </section>
  </div>
  {% include "chrome.njk" %}
</main>
<script src="assets/js/report.js"></script>
</body>
</html>
